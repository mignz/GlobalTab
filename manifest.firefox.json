{
  "manifest_version": 2,
  "name": "GlobalTab",
  "description": "New tab page showing your favorite bookmarks.",
  "version": "1.3.0",
  "icons": {
    "16": "assets/img/icon_16.png",
    "48": "assets/img/icon_48.png",
    "96": "assets/img/icon_128.png"
  },
  "author": "Miguel Nunes",
  "chrome_url_overrides": {
    "newtab": "globaltab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "globaltab.html"
  },
  "permissions": [
    "bookmarks"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{a961c0b0-2bd4-42ca-8251-ae7b95f9f8af}"
    }
  }
}
